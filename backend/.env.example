# LexExtract — Backend Environment Configuration Example
# Copy this file to .env for local overrides (never commit production secrets)

PROJECT_NAME="LexExtract"
PROJECT_DESCRIPTION="Legal Document Keyword & Entity Extractor"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Security & Cryptographic Configuration
SECRET_KEY="lexextract-dev-secret-key-change-in-production-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM="HS256"

# Upload Storage Configuration
UPLOAD_DIR="storage/uploads"
MAX_UPLOAD_SIZE_BYTES=26214400  # 25 MB

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
